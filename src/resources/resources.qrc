<RCC>
    <qresource prefix="/images">
        <file>MySQL.png</file>
        <file>Back.png</file>
        <file>Front.png</file>
        <file>DB2.png</file>
        <file>grupo.png</file>
    </qresource>
    <qresource prefix="/icons">
        <file>add.png</file>
        <file>adddb.png</file>
        <file>delete.png</file>
        <file>edit.png</file>
        <file>database.png</file>
        <file>DB2.png</file>
        <file>Front.png</file>
        <file>MySQL.png</file>
        <file>resources.qrc</file>
        <file>table.png</file>
        <file>Recent.png</file>
        <file>project.png</file>
        <file>tutorial.png</file>
        <file>capas.png</file>
        <file>hogar.png</file>
        <file>sombrero-de-graduacion.png</file>
        <file>gorro-de-graduacion.png</file>
        <file>VS.png</file>
        <file>vs2.png</file>
        <file>recent2.png</file>
        <file>exp.png</file>
        <file>Icono React.webp</file>
    </qresource>
    <qresource prefix="/inja/backend">
        <file alias="controllers">inja_templates/backend/controllers.inja</file>
        <file alias="models">inja_templates/backend/models.inja</file>
        <file alias="modelsIndex">inja_templates/backend/modelsIndex.inja</file>
        <file alias="routes">inja_templates/backend/routes.inja</file>
        <file alias="routesIndex">inja_templates/backend/routesIndex.inja</file>
        <file alias="env">inja_templates/backend/env.inja</file>
    </qresource>
    <qresource prefix="/project_templates">
        <file alias="runEditor">project_templates/runEditor.js</file>
        <file alias="backend">project_templates/backend_template.zip</file>
        <file alias="frontend">project_templates/frontend_template.zip</file>
    </qresource>
    <qresource prefix="/inja/frontend">
        <file alias="app">inja_templates/frontend/app.inja</file>
        <file alias="view">inja_templates/frontend/view.inja</file>
        <file alias="model">inja_templates/frontend/model.inja</file>
        <file alias="service">inja_templates/frontend/service.inja</file>
        <file alias="component">inja_templates/frontend/component.inja</file>
    </qresource>
    <qresource prefix="/inja/nginx">
        <file alias="nginx_conf">inja_templates/nginx/nginx_template.inja</file>
    </qresource>
    <qresource prefix="/styles">
        <file alias="frontenddashboard">styles/frontenddashboard.qss</file>
        <file alias="projectspanel">styles/projectspanel.qss</file>
        <file alias="primarybutton">styles/primarybutton.qss</file>
        <file alias="secondarybutton">styles/secondarybutton.qss</file>
        <file alias="backenddashboard">styles/backenddasboard.qss</file>
        <file alias="deletebutton">styles/deletebutton.qss</file>
    </qresource>
    <qresource prefix="/gifs">
        <file>loading.gif</file>
    </qresource>
    <qresource prefix="/resources">
        <file>log_tutorials/begginer/begginer-tutorial-1.json</file>
        <file>log_tutorials/begginer/begginer-tutorial-2.json</file>
        <file>log_tutorials/begginer/begginer-tutorial-3.json</file>
        <file>log_tutorials/begginer/begginer-tutorial-4.json</file>
        <file>log_tutorials/begginer/begginer-tutorial-5.json</file>
        <file>log_tutorials/begginer/begginer-tutorial-6.json</file>
        <file>log_tutorials/intermedium/intermediate-tutorial-1.json</file>
        <file>log_tutorials/intermedium/intermediate-tutorial-2.json</file>
        <file>log_tutorials/intermedium/intermediate-tutorial-3.json</file>
        <file>log_tutorials/intermedium/intermediate-tutorial-4.json</file>
        <file>log_tutorials/intermedium/intermediate-tutorial-5.json</file>
    </qresource>
    <qresource prefix="/babel">
        <file alias="editorFrontend">babel/editorFront.js</file>
        <file alias="editorBackend">babel/editorBack.js</file>
    </qresource>
</RCC>
