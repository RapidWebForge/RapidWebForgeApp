// src/models/{{ model_name }}.ts
export interface {{ model_name }} {
    id?: number;
{% for field in fields %}
    {{ field.name }}: {{ render_type(field.type) }};
{% endfor %}
}

export const defaultPost{{ model_name }} : {{ model_name }} = {
{% for field in fields %}
    {{ field.name }}: {{ render_default_type(field.type) }},
{% endfor %}
}

export const defaultPut{{ model_name }} : {{ model_name }} = {
    id: 0,
{% for field in fields %}
    {{ field.name }}: {{ render_default_type(field.type) }},
{% endfor %}
}

export const {{ model_name }}Defaults = {
    defaultPost{{ model_name }},
    defaultPut{{ model_name }},
}
