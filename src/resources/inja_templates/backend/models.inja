const { DataTypes } = require('sequelize');

module.exports = (sequelize) => {
  const {{ name }} = sequelize.define('{{ name }}', {
    {% for field in fields %}
    {{ field.name }}: {
      type: DataTypes.{{ field.type }},
      {% if field.isForeignKey %}
      references: {
        model: '{{ field.foreignKeyTableLower }}', // Nombre de la tabla que referencia
        key: 'id',
      },
      {% else %}
      allowNull: {{ field.isNull }},
      unique: {{ field.isUnique }}
      {% endif %}
    }{% if loop.is_last %}{% else %},{% endif %}

    {% endfor %}
  },{
  tableName: '{{ nameConst }}',
  timestamps: true,
});

{% for field in fields %}
{% if field.isForeignKey %}
{{ name }}.associate = (models) => {
  {{ name }}.belongsTo(models.{{ field.foreignKeyTable }}, {
    foreignKey: '{{ field.name }}', // LLave foránea
    onDelete: 'SET NULL', // Qué hacer al eliminar la tabla (puedes ajustar esto)
    onUpdate: 'CASCADE',
  });
};
{% endif %}
{% endfor %}

  return {{ name }};
}
